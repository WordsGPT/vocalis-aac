# Server-side keys and the login for personal voice creation/use.
# Copy to .env for local development. Never put these in VITE_* variables.
GROQ_API_KEY=
GEMINI_API_KEY=
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SECRET=

# Optional Pocket TTS CPU worker. These enable public Pocket speech without login.
POCKET_TTS_URL=
POCKET_TTS_SECRET=
