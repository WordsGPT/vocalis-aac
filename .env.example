# Optional API Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_URL=http://localhost:11434

# Qwen3-TTS cloned voice (defaults to ../qwen3-tts-runtime/saved_voice.pt).
# Model aliases: fast/0.6b (default), quality/1.7b, or a full model ID.
QWEN_VOICE_PROFILE=/absolute/path/to/saved_voice.pt
QWEN_TTS_MODEL=fast
# auto uses FlashAttention 2 when installed, then Qwen's eager path as fallback.
QWEN_TTS_ATTENTION=auto
# Hard safety ceiling; normal phrases receive a smaller text-relative limit.
QWEN_TTS_MAX_NEW_TOKENS=256
# Load in the background at server startup instead of on the first spoken phrase.
QWEN_TTS_PRELOAD=true
# Run one discarded phrase at startup so the first real press has warm CUDA kernels.
QWEN_TTS_WARMUP=true
